import cv2  # Thư viện OpenCV, đọc camera và xử lý hình ảnh
import mediapipe as mp  # Nhận diện bàn tay và vị trí các ngón tay
from gtts import gTTS   # Google Text to Speech
import pygame   # phát file âm thanh
import threading    # Chạy âm thanh song song với chương trình
import time # Xử lý thời gian
import os   # Quản lý file
import warnings # Tắt cảnh báo
from PIL import Image, ImageDraw, ImageFont
import numpy as np

warnings.filterwarnings("ignore")

mp_drawing = mp.solutions.drawing_utils     # Vẽ các điểm trên bàn tay
mp_hands = mp.solutions.hands   # nhận diện bàn tay


def play_audio(text):       # Hàm phát âm thanh
    filename = f"voice_{text.replace(' ', '_').lower()}.mp3"
    tts = gTTS(text=text, lang='vi')    # Tạo giọng nói, tiếng việt
    tts.save(filename)

    #pygame load file mp3 và phát âm thanh
    pygame.mixer.init()
    pygame.mixer.music.load(filename)
    pygame.mixer.music.play()

    # Tunggu sampai suara selesai
    while pygame.mixer.music.get_busy():    # chương trình chờ cho tới khi phát âm thanh xong
        time.sleep(0.1)

    pygame.mixer.quit() # tắt mixer
    os.remove(filename)


def detect_gesture(landmarks):  # nhận diện cử chỉ tay
    # chỉ lấy tọa độ y
    thumb_tip = landmarks.landmark[4].y
    index_tip = landmarks.landmark[8].y
    middle_tip = landmarks.landmark[12].y
    ring_tip = landmarks.landmark[16].y
    pinky_tip = landmarks.landmark[20].y

    thumb_base = landmarks.landmark[2].y
    index_base = landmarks.landmark[5].y
    middle_base = landmarks.landmark[9].y
    ring_base = landmarks.landmark[13].y
    pinky_base = landmarks.landmark[17].y

    thumb_tip_x = landmarks.landmark[4].x
    thumb_base_x = landmarks.landmark[2].x
    index_tip_x = landmarks.landmark[8].x
    index_base_x = landmarks.landmark[5].x
    middle_tip_x = landmarks.landmark[12].x
    middle_base_x = landmarks.landmark[9].x

    # Hello (tất cả mở)
    if (thumb_tip < thumb_base and
        index_tip < index_base and
        middle_tip < middle_base and
        ring_tip < ring_base and
        pinky_tip < pinky_base):
        return "He lô phờ ren"

        # Súng
    if (abs(index_tip_x - index_base_x) > abs(index_tip - index_base) and
        abs(thumb_tip_x - thumb_base_x) > 0.05 and
        middle_tip > middle_base and
        ring_tip > ring_base and
        pinky_tip > pinky_base):
        return "Đừng để mình phải lóng"

    # Like 👍
    if (thumb_tip < thumb_base - 0.02 and
        index_tip > index_base and
        middle_tip > middle_base and
        ring_tip > ring_base and
        pinky_tip > pinky_base):
        return "Like"

    # Horns 🤘
    if (index_tip < index_base and
        pinky_tip < pinky_base and
        middle_tip > middle_base and
        ring_tip > ring_base):
        return "Híp hóp never die"

    # Chúc ngủ ngon
    if (index_tip < index_base and middle_tip < middle_base and 
        ring_tip > ring_base and pinky_tip > pinky_base):
        return "Chúc ngủ ngon"

    return None

# --- Mở camera ---
cap = cv2.VideoCapture(0) # Mở cam, 0 là camera mặc định

last_gesture = None
last_time = 0
# Tránh phát âm thanh liên tục
# Chỉ phát khi gesture thay đổi

font_pil = ImageFont.truetype("arial.ttf", 40)


# Màu cho từng gesture, OpenCV dùng BGR
gesture_colors = {
    "He lô phờ ren": (255, 0, 0),      
    "Đừng để mình phải lóng": (0, 255, 0),        # 
    "Contoh": (0, 165, 255),        # 
    "Híp hóp never die": (255, 0, 255),     # 
    "Like": (245, 174, 108),
    "Chúc ngủ ngon": (255, 255, 0)
}

# Độ tin cậy phát hiện, và tracking
# with ... as ... : tạo obj, dùng obj, tự giải phóng khi dùng xong
# Mediapipe.Hands: tạo model nhận diện bàn tay, có thể: detect, xác định vị trí, 21 landmarks
with mp_hands.Hands(min_detection_confidence=0.7, min_tracking_confidence=0.7) as hands:
    while True:
        ret, frame = cap.read() # đọc dữ liệu từ cam, return boolean,  frame
        if not ret: # ko thành công
            continue

        frame = cv2.flip(frame, 1)  # lật ảnh theo trục y
        rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)  # chuyển hệ màu (scr, code)
        result = hands.process(rgb_frame)   # process: detect bàn tay, xác định vị trí, tìm 21 landmark

        gesture = None
        if result.multi_hand_landmarks: # nếu phát hiện tay
            for hand_landmarks in result.multi_hand_landmarks:
                mp_drawing.draw_landmarks(frame, hand_landmarks, mp_hands.HAND_CONNECTIONS) # vẽ 21 điểm, nối các đường
                gesture = detect_gesture(hand_landmarks)

        if gesture:
            text = gesture
            color = gesture_colors.get(text, (255, 255, 255))  # warna default putih
            font = cv2.FONT_HERSHEY_SIMPLEX

            x, y = 50, 80

            img_pil = Image.fromarray(frame)    # chuyển numpy array thành PIL Image
            draw = ImageDraw.Draw(img_pil)

            #viền đen
            draw.text((x+2, y+2), text, font=font_pil, fill=(0,0,0))

            # chữ chính
            draw.text((x, y), text, font=font_pil, fill=color)
            frame = np.array(img_pil)   # chuyển về lại OpenCV
            

            if gesture != last_gesture and time.time() - last_time > 2: # chỉ phát âm thanh khi cử chỉ thay đổi và sau ít nhất 2 giây
                threading.Thread(target=play_audio, args=(text,)).start()   # tạo luồng để chạy hàm play_audio, tránh xung đột với camera
                last_gesture = gesture
                last_time = time.time()

        cv2.imshow("Hand Gesture Recognition", frame)

        if cv2.waitKey(1) & 0xFF == 27:
            break

cap.release()
cv2.destroyAllWindows()

